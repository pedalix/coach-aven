# CoachAven — the Slack coding-agent orchestrator (Socket Mode singleton).
# Rendered by infra/prod/deploy.sh (placeholders __USER__/__REMOTE_DIR__/__NODE__
# substituted at install). All heavy work runs on Daytona sandboxes; this is just
# the control plane, so it's tiny. No ports: Socket Mode dials OUT to Slack.
[Unit]
Description=CoachAven — per-project Claude Code sandboxes (Slack bot)
After=network-online.target
Wants=network-online.target
# Don't hammer Daytona/Slack if it crash-loops: cap restarts in a window, then fail.
# (These are [Unit] keys — systemd ignores them under [Service].)
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REMOTE_DIR__
# tsx as a Node loader → the service's main PID is node, so systemd's SIGTERM
# reaches the app directly (clean shutdown, no npm/tsx fork in between).
ExecStart=__NODE__ --import tsx src/cli.ts slack
Environment=NODE_ENV=production
# Runtime secrets/config are loaded by the app via dotenv from __REMOTE_DIR__/.env
Restart=always
RestartSec=3
# Journald captures stdout/stderr → `journalctl -u __SERVICE__`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__SERVICE__

[Install]
WantedBy=multi-user.target
