# CoachAven prod deploy — target config for infra/prod/deploy.sh
# Copy to infra/prod/.env and fill in. This is the DEPLOY target, not the app's
# runtime secrets (those live in the repo-root .env, pushed via `push-secrets`).

# The shared Hetzner VM `aven-prod`. `deployer` runs the service + owns files;
# `root` installs the systemd unit. Both must be reachable over SSH with your
# default keys/agent.
DEPLOY_HOST=<bot-host>
DEPLOY_USER=deployer
ROOT_USER=root

# Where the app lives on the box (deployer-owned). Mirrors /var/www/aven.
REMOTE_DIR=/var/www/coach-aven

# systemd unit name (installed at /etc/systemd/system/<SERVICE_NAME>.service).
SERVICE_NAME=coach-aven
