# One serve process per project on the bot host (deploy.sh does not install this yet — by hand,
# as root): fill __SLUG__ / __PORT__, then `systemctl daemon-reload && systemctl enable --now coach-aven-sources@bluefin-ops`.
# Reads the same .env as the bot (SOURCES_SERVE_TOKEN lives there) and the same data/ directory.
[Unit]
Description=CoachAven sources serve (%i)
After=network-online.target coach-aven.service
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__REMOTE_DIR__
EnvironmentFile=__REMOTE_DIR__/.env
ExecStart=__NODE__ --import tsx src/cli.ts sources serve %i --listen 127.0.0.1:__PORT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
