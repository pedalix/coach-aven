# The sources daemon (OpenSpec sources-daemon): ingest + serve for every project with a `sources` block
# in the projects config it reads, where the data lives — the bot host for a single-machine install,
# a tenant's own machine otherwise (C3: Bluefin's VM for bluefin-ops). Replaces the per-slug serve unit
# (coach-aven-sources.service.tmpl). By hand, as root: fill the placeholders, then
# `systemctl daemon-reload && systemctl enable --now coach-aven-sources-daemon`.
# `deploy.sh install` grants the deployer start/stop/restart on this unit, and `deploy.sh deploy` restarts it
# after the bot when it exists.
#
# The app reads __REMOTE_DIR__/.env itself (dotenv, like the bot's unit — no EnvironmentFile: systemd's parser is not
# dotenv's). The .env must hold SOURCES_DAEMON_TOKEN (the bearer the bot sends: the bot's `sources.daemon.tokenEnv`
# names the same value on its side), PROJECTS_CONFIG_PATH, AVEN_DATA_DIR and AVEN_TZ, plus what the
# pullers need (source tokens live under ~/.config/coach-aven/sources/<slug>/) and a GitHub credential
# for the tenant checkout. On the bot host itself, set SOURCES_DAEMON=1 in the BOT's .env and restart
# it first: the bot then ingests nothing, and its data locks are released for the daemon.
[Unit]
Description=CoachAven sources daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__REMOTE_DIR__
ExecStart=__NODE__ --import tsx src/cli.ts sources daemon --listen __LISTEN__
# A pass in flight finishes before the locks go (src/sources/daemon.ts stop()); give it time.
TimeoutStopSec=90
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
