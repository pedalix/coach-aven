# Deploy target of THIS installation — read by infra/deploy/deploy.sh <slug> <command> from
# infra/<slug>/deploy.env. Not a secret (a host and user names): tracked in the ops repo, so the
# deploy workflow reads it from its own checkout. The app's runtime secrets are in .env (untracked).

# Your bot host: any Linux box with systemd + ssh. `deployer` runs the service + owns files;
# `root` installs the systemd unit. Both must be reachable over SSH with your default keys/agent.
DEPLOY_HOST=<bot-host>
DEPLOY_USER=deployer
ROOT_USER=root

# Where the app lives on the box (deployer-owned).
REMOTE_DIR=/var/www/coach-aven

# systemd unit name (installed at /etc/systemd/system/<SERVICE_NAME>.service).
SERVICE_NAME=coach-aven

# The chat driver this installation runs as its default surface: slack (default), teams or web
# (`CHAT_SURFACES` in .env adds others beside it). Rendered into the unit's run command at
# `install`; the deploy health check follows it.
# CHAT_DRIVER=teams

# How the installation runs (OpenSpec container-deploy): compose — the published image
# ghcr.io/<owner>/coach-aven under `docker compose` in REMOTE_DIR/compose, a deploy names a version and
# uploads nothing (recommended) — or systemd, the unit and the tar deploy (the default while installations
# move; it retires later). infra/deploy/README.md has the move checklist.
# RUNTIME=compose

# The image repository (compose): the product's package, or your fork's own.
# IMAGE=ghcr.io/pedalix/coach-aven

# A canary installation runs main: only it accepts a commit's image (`deploy sha-<commit>`, from
# deploy.sh and from the deploy workflow alike). A release installation takes vX.Y.Z only.
# CANARY=1

# The sources daemon as a second container (compose), listening here; the bot's projects config names
# the same address in `sources.daemon` (docs/runtime-config.md → Sources daemon). Unset = no daemon.
# DAEMON_LISTEN=127.0.0.1:3416
