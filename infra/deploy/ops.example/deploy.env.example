# Deploy target of THIS installation — read by infra/deploy/deploy.sh <slug> <command> from
# infra/<slug>/deploy.env. Not a secret (a host and user names): tracked in the ops repo, so the
# deploy workflow reads it from its own checkout. The app's runtime secrets are in .env (untracked).

# Your bot host: any Linux box with systemd + ssh. `deployer` runs the service + owns files;
# `root` installs the systemd unit. Both must be reachable over SSH with your default keys/agent.
DEPLOY_HOST=<bot-host>
DEPLOY_USER=deployer
ROOT_USER=root

# Where the app lives on the box (deployer-owned).
REMOTE_DIR=/var/www/coach-aven

# systemd unit name (installed at /etc/systemd/system/<SERVICE_NAME>.service).
SERVICE_NAME=coach-aven
