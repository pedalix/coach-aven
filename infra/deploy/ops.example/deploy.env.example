# Deploy target of THIS installation — read by infra/deploy/deploy.sh <slug> <command> from
# infra/<slug>/deploy.env. Not a secret (a host and user names): tracked in the ops repo, so the
# deploy workflow reads it from its own checkout. The app's runtime secrets are in .env (untracked).

# Your bot host: any Linux box with Docker Engine + ssh. `deployer` runs the containers + owns files;
# `root` only creates REMOTE_DIR at install. Both must be reachable over SSH with your default keys/agent.
DEPLOY_HOST=<bot-host>
DEPLOY_USER=deployer
ROOT_USER=root

# Where the app lives on the box (deployer-owned).
REMOTE_DIR=/var/www/coach-aven

# The installation's name: the compose project, and the journal tag of its containers.
SERVICE_NAME=coach-aven

# The chat driver this installation runs as its default surface: slack (default), teams or web
# (`CHAT_SURFACES` in .env adds others beside it). Rendered into the bot container's command at
# `install`; the deploy health check follows it.
# CHAT_DRIVER=teams

# How the installation runs (OpenSpec container-deploy): the published image ghcr.io/<owner>/coach-aven
# under `docker compose` in REMOTE_DIR/compose; a deploy names a version and uploads nothing. There is no
# RUNTIME key any more: a leftover `RUNTIME=compose` is accepted, `RUNTIME=systemd` refused — the unit and
# the tar deploy left after v0.44.0 (infra/deploy/README.md has the move checklist).

# The image repository: the product's package, or your fork's own.
# IMAGE=ghcr.io/pedalix/coach-aven

# A canary installation runs main: only it accepts a commit's image (`deploy sha-<commit>`, from
# deploy.sh and from the deploy workflow alike). A release installation takes vX.Y.Z only.
# CANARY=1

# The installation's stage for `npm run ship` (OpenSpec ship-dispatcher): installations move in stage order, the
# lowest stage gets the newest green main, every later stage gets what the stage below it runs. Without STAGE, `ship`
# never touches this installation (deploy.sh still does, by hand). Example: a canary 1, a staging 2, prod 3.
# STAGE=1

# DEPLOY_HOST=localhost: the installation runs on the operator's own machine — deploy.sh runs its commands here with
# no ssh (install's root stage is not supported there).

# The sources daemon as a second container, listening here; the bot's projects config names
# the same address in `sources.daemon` (docs/runtime-config.md → Sources daemon). Unset = no daemon.
# DAEMON_LISTEN=127.0.0.1:3416
