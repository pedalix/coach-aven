# CoachAven runtime .env of an INSTALLATION — the app's runtime secrets/config ON THE BOX.
#
# The counterpart of the repo-root .env (which is your LOCAL DEV copy). `infra/deploy/deploy.sh
# <slug> export` uploads this file to REMOTE_DIR/.env; `import` pulls the box's live copy back.
# Keep the installation's truth ONLY in its overlay, infra/<slug>/ — never mix it into the
# repo-root files.
#
# Fastest way to populate a fresh overlay from a running box: `npm run ops -- <slug> import`
# (pulls .env, projects.config.json, github-app-private-key.pem). This example only documents
# the installation-specific values vs. dev.

# ── Sandboxes (ssh-docker: containers on a Docker host) ──────────────────────
# ssh-docker is the only driver and the default. Keep SANDBOX_DRIVER=ssh-docker written out
# anyway: older releases default to a driver that has since been removed, and a rollback
# without the line would send every project without a "driver" field there
# (docs/sandbox-drivers.md, Selecting the driver).
SANDBOX_DRIVER=ssh-docker
# The sandbox host: an ssh target the bot's user reaches with key auth (user@host, or an alias
# in that user's ~/.ssh/config; the remote user in the docker group), or `local` when the
# sandboxes run on this box's own Docker daemon. Runtime: privileged by default, sysbox-runc
# (preferred) where sysbox is installed on the sandbox host.
SSHDOCKER_HOST=aven@sandboxes.example.com
# SSHDOCKER_RUNTIME=sysbox-runc
# Idle minutes before the bot stops a project's container; the next turn wakes it (floor 10;
# 0 = never). Decide it on purpose: a stop ends every process in the container, a Sail stack
# included.
SANDBOX_AUTOSTOP_MINUTES=30

# ── Sandbox image ────────────────────────────────────────────────────────────
SNAPSHOT_IMAGE=ghcr.io/<your-org>/coach-aven-sandbox-laravel:latest
# Sandbox Claude Code CLI pin (x.y.z) — see .env.example at the repo root. Warm sandboxes
# converge in place; canary via "cliVersion" per project in projects.config.json.
CLAUDE_CLI_VERSION=2.1.282
SANDBOX_WORK_DIR=/root/work

# A new installation uses the DEFAULTS: sandboxes `proj-<slug>`, channels `aven-<slug>`,
# sandbox label managedBy=coach-aven. Dev sets dev-* prefixes to stay out of prod's way, and so must
# any installation sharing a Docker host with another one (the idle stop assumes one bot per container).
# An installation whose channels/sandboxes predate these defaults pins its own values:
# SLACK_CHANNEL_PREFIX=<old>-aven-
# SANDBOX_MANAGED_BY=<old label>

# ── Claude Code (subscription) ───────────────────────────────────────────────
# Unattended service → use a stable `claude setup-token` value (NOT the ~/.claude fallback).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub App (prod uses the App, not a plain token) ────────────────────────
GITHUB_APP_ID=123456
# Path is resolved relative to REMOTE_DIR on the box (export uploads the PEM alongside).
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# ── Slack bot (PROD app — its own xoxb-/xapp-) ───────────────────────────────
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxx

# CHAT_SURFACES=                  # additional chat drivers beside the run mode's (`orch <driver>` from deploy.env CHAT_DRIVER),
#                                 # comma-separated; each needs its own settings (the Slack or Teams block) and a project
#                                 # bound on it. A surface that cannot start fails the boot naming it.

# ── Teams bot (a Teams installation: deploy.env CHAT_DRIVER=teams) ───────────
# The three ids are the infra/teams module's outputs (terraform output in your teams/ root):
# bot_app_id, bot_tenant_id, bot_app_password. The driver listens on 127.0.0.1:TEAMS_PORT;
# the host's nginx proxies https://<host>/api/messages to it. Leave unset on a Slack installation.
# TEAMS_APP_ID=00000000-0000-4000-8000-000000000000
# TEAMS_TENANT_ID=00000000-0000-4000-8000-000000000000
# TEAMS_APP_PASSWORD=
# TEAMS_PORT=3978
# TEAMS_STATUS_MIN_MS=2000        # status-card edit coalescing window
# TEAMS_OPERATORS=                # the installation's operators, comma-separated: Teams user ids (29:…, as
#                                 # `/users` lists them) or Entra object ids. Only they may /usage, /reload
#                                 # and manage access; nobody can until this is set.
# TEAMS_TARGETED=0                # 1: private replies in channels as targeted messages (seen by one person,
#                                 # gone after 24 h); a refused send falls back to the person's 1:1 chat
# TEAMS_TRACE=0                   # 1: one journal line per inbound activity with its shape — type, scope, attachment
#                                 # content types/names/hosts, never the text — to see what Teams sends for a file
#                                 # the bot ignored. `full`: the whole inbound body and every Connector/Graph
#                                 # request and response, secrets scrubbed — people's messages land in the
#                                 # journal, so a staging installation only. Diagnostic; leave unset otherwise
# Registry path on the box. The code reads PROJECTS_CONFIG_PATH (plural); if unset it
# defaults to REMOTE_DIR/projects.config.json, which is correct — so this can stay unset.
# PROJECTS_CONFIG_PATH=./projects.config.json

# ── Web chat (a web installation: deploy.env CHAT_DRIVER=web, or CHAT_SURFACES=web) ──
# docs/web.md. The listener is 127.0.0.1:WEB_PORT behind nginx (SSE: proxy buffering off on /stream).
# Login: OIDC against your issuer — for a Cognito pool the installation's Terraform creates the client
# (output `aven_web`; the secret in Secrets Manager). All five login settings are required together.
# WEB_OIDC_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/eu-central-1_XXXXXXXXX
# WEB_OIDC_CLIENT_ID=
# WEB_OIDC_CLIENT_SECRET=
# WEB_BASE_URL=https://chat.example.com
# WEB_SESSION_SECRET=             # openssl rand -hex 32
# WEB_ORG=example-org             # the organization behind the issuer: the surface's tenant id
# WEB_OPERATORS=                  # OIDC subjects or e-mails, comma-separated: operator verbs + access admins
# WEB_ALLOW=                      # e-mails or group:<name>; empty = everyone the issuer lets in (open mode)
# WEB_PORT=8787

# ── Per-project MCP secrets (caldora's grafana MCP) ──────────────────────────
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ── MCP gateway (a project's mcp entry with "auth": "gateway-m2m") ────────────
# The bot mints its own token per project and hands the sandbox only that (src/gwtoken.ts,
# docs/runtime-config.md → MCP gateway). Default (no "oauth" on the entry): the Auth0 client
# coach-aven-<slug>.
# AUTH0_M2M_TOKEN_URL=https://<tenant>/oauth/token
# AUTH0_M2M_CALDORA_ID=
# AUTH0_M2M_CALDORA_SECRET=
# An entry WITH an "oauth" object (any OAuth 2.0 server, e.g. Amazon Cognito) reads only these,
# and only for that entry; its token URL and scope live in projects.config.json:
# GATEWAY_OAUTH_CALDORA_ID=
# GATEWAY_OAUTH_CALDORA_SECRET=

# ── YouTrack MCP (<grafana-host>/yt-mcp, read-only, per-project scoping) ─
# base64("user:password") per project — the nginx basic-auth users live in
# bluefin-infra proxy/nginx/htpasswd-yt-mcp; referenced from projects.config.json as
# headers.Authorization = "Basic ${YT_MCP_BASIC_AUTH_<PROJECT>}".
YT_MCP_BASIC_AUTH_CALDORA=
YT_MCP_BASIC_AUTH_LUMORA=
YT_MCP_BASIC_AUTH_HOLIDAYSHOP_HSX=

# ── Repo mirrors (scripts/mirror.ts, deployer crontab) ───────────────────────
# Read side only: fine-grained PATs, one per upstream owner, Contents:read on the mirrored
# repo(s) ONLY. The write side is the App itself (scoped mint per mirror repo). One line per
# `srcTokenEnv` named in mirrors.json (see mirrors.example.json); unset → that mirror is a snapshot.
MIRROR_SRC_UPSTREAM_CO=
# MIRROR_SRC_PARTNER_LABS=

# ── Observability: Sentry (optional) ─────────────────────────────────────────
# SENTRY_DSN enables error + performance reporting (off if unset). Logs opt-in via SENTRY_LOGS.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_LOGS=0

# Operator error alerts → Slack channel id (bot must be in it). Optional.
# AVEN_ALERT_CHANNEL=
