# The gateway's own secrets. Copy to .env beside compose.yaml (chmod 600): they stay on the
# gateway host, and neither the bot nor a sandbox ever reads them.

# Sentry: the token of an Internal Integration (Settings → Developer Settings → Custom Integrations)
# with read permissions only: Issue & Event: Read, Project: Read, Organization: Read. Sentry's
# hosted MCP server takes it as "Authorization: Sentry-Bearer <token>"; config.yaml adds the scheme.
SENTRY_AUTH_TOKEN=

# Encrypts the MCP session state, so the conversations that are running keep their sessions over
# a gateway restart: openssl rand -hex 32
AGW_SESSION_KEY=
