# A working-tree build (`docker build .`) sees tracked files only, like the CI build from `git archive`:
# nothing of an installation, no secret, no state, no private notes. Mirrors .gitignore's runtime entries.
.git
node_modules
hub/node_modules
.env
.env.*
!.env.example
*.pem
state.json
state.json.tmp
queue.jsonl
projects.config.json
/projects.d
drafts
usage
feedback
facts
memory
events
data
shadow
mirrors
mirrors.json
*.log
# every installation's ops repo lives under infra/<slug>/ — only the public tooling is tracked
infra/*
!infra/README.md
!infra/deploy
!infra/teams
.terraform
*.tfstate
*.tfstate.*
.idea
# .claude/commands and .claude/skills are tracked; the worktrees and local settings are not
.claude/worktrees
.claude/settings.local.json
.agents
ideas
AGENTS.md
CLAUDE.local.md
