{
  "workspaces": {
    "T0YOURHOME1": [
      "acme-shop",
      "acme-cms",
      "acme-monitoring",
      "ops-plain"
    ],
    "T0CLIENT001": [
      "acme-monitoring"
    ]
  },
  "projects": [
    {
      "slug": "acme-shop",
      "repos": [
        "your-org/acme-shop-api"
      ],
      "youtrackProjects": [
        "SHOP",
        "CMS"
      ],
      "driver": "daytona",
      "systemPrompt": "Project context goes here (appended after the base prompt): domain, what each repo is and how they relate, merge/deploy-order rules, doc links. Repo coding conventions belong in each repo's own CLAUDE.md, not here.",
      "env": {},
      "mcp": [
        {
          "name": "grafana",
          "url": "https://observe.example.com/mcp",
          "headers": {
            "Authorization": "Basic ${GRAFANA_MCP_BASIC_AUTH}"
          }
        },
        {
          "name": "youtrack",
          "url": "https://observe.example.com/yt-mcp",
          "headers": {
            "Authorization": "Basic ${YT_MCP_BASIC_AUTH_ACME_SHOP}"
          }
        },
        {
          "name": "example-stdio-server",
          "command": "docker",
          "args": [
            "run",
            "-i",
            "--rm",
            "-e",
            "SOME_TOKEN",
            "example/mcp-server",
            "-t",
            "stdio"
          ],
          "env": {
            "SOME_TOKEN": "${SOME_TOKEN}"
          }
        }
      ]
    },
    {
      "slug": "acme-cms",
      "repos": [
        "your-org/acme-cms-studio",
        "your-org/acme-cms-sync"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "acme-monitoring",
      "repos": [
        "your-org/acme-monitoring"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "ops-plain",
      "repos": [
        "REPLACE-you/REPLACE-ops-ledger"
      ],
      "driver": "ssh-docker",
      "gitFlow": "direct",
      "sandbox": {
        "privileged": false,
        "dind": false,
        "mounts": [
          "/srv/ops/sources:/data/sources"
        ]
      },
      "scrubSecrets": true,
      "systemPrompt": "Example of a docker-less project on the `plain` image variant (snapshot/plain/Dockerfile): an ordinary unprivileged container with a read-only data mount, whose agent commits straight to the checkout's branch (gitFlow direct — no worktree, no PR). See docs/sandbox-drivers.md and docs/runtime-config.md.",
      "env": {},
      "mcp": []
    }
  ]
}
