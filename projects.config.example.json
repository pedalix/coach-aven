{
  "projects": [
    {
      "slug": "acme-shop",
      "repos": [
        "your-org/acme-shop-api"
      ],
      "youtrackProjects": [
        "SHOP",
        "CMS"
      ],
      "systemPrompt": "Project context goes here (appended after the base prompt): domain, what each repo is and how they relate, merge/deploy-order rules, doc links. Repo coding conventions belong in each repo's own CLAUDE.md, not here.",
      "env": {},
      "mcp": [
        {
          "name": "grafana",
          "url": "https://observe.example.com/mcp",
          "headers": {
            "Authorization": "Basic ${GRAFANA_MCP_BASIC_AUTH}"
          }
        },
        {
          "name": "youtrack",
          "url": "https://observe.example.com/yt-mcp",
          "headers": {
            "Authorization": "Basic ${YT_MCP_BASIC_AUTH_ACME_SHOP}"
          }
        },
        {
          "name": "example-stdio-server",
          "command": "docker",
          "args": [
            "run",
            "-i",
            "--rm",
            "-e",
            "SOME_TOKEN",
            "example/mcp-server",
            "-t",
            "stdio"
          ],
          "env": {
            "SOME_TOKEN": "${SOME_TOKEN}"
          }
        }
      ],
      "sandbox": {
        "dind": true,
        "image": "ghcr.io/your-org/coach-aven-sandbox-laravel:REPLACE-gitsha"
      }
    },
    {
      "slug": "acme-cms",
      "repos": [
        "your-org/acme-cms-studio",
        "your-org/acme-cms-sync"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "acme-monitoring",
      "repos": [
        "your-org/acme-monitoring"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "ops-plain",
      "repos": [
        "REPLACE-you/REPLACE-ops-ledger"
      ],
      "gitFlow": "direct",
      "scrubSecrets": true,
      "systemPrompt": "Example of a project on the published `plain` sandbox image (what a project without a `sandbox` block gets): an ordinary unprivileged container whose agent commits straight to the checkout's branch (gitFlow direct — no worktree, no PR). See docs/sandbox-drivers.md and docs/runtime-config.md.",
      "env": {},
      "mcp": []
    }
  ]
}
