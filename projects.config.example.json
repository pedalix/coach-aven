{
  "workspaces": {
    "T0YOURHOME1": [
      "caldora",
      "cms-general",
      "dorfberg-monitoring",
      "ops-plain"
    ],
    "T0CLIENT001": [
      "dorfberg-monitoring"
    ]
  },
  "projects": [
    {
      "slug": "caldora",
      "repos": [
        "BluefinOrg/REPLACE-caldora-repo"
      ],
      "youtrackProjects": [
        "CG",
        "CB"
      ],
      "driver": "daytona",
      "systemPrompt": "Project context goes here (appended after the base prompt): domain, what each repo is and how they relate, merge/deploy-order rules, doc links. Repo coding conventions belong in each repo's own CLAUDE.md, not here.",
      "env": {},
      "mcp": [
        {
          "name": "grafana",
          "url": "https://observe.example.com/mcp",
          "headers": {
            "Authorization": "Basic ${GRAFANA_MCP_BASIC_AUTH}"
          }
        },
        {
          "name": "youtrack",
          "url": "https://observe.example.com/yt-mcp",
          "headers": {
            "Authorization": "Basic ${YT_MCP_BASIC_AUTH_CALDORA}"
          }
        },
        {
          "name": "example-stdio-server",
          "command": "docker",
          "args": [
            "run",
            "-i",
            "--rm",
            "-e",
            "SOME_TOKEN",
            "example/mcp-server",
            "-t",
            "stdio"
          ],
          "env": {
            "SOME_TOKEN": "${SOME_TOKEN}"
          }
        }
      ]
    },
    {
      "slug": "cms-general",
      "repos": [
        "BluefinOrg/REPLACE-cms-repo-a",
        "BluefinOrg/REPLACE-cms-repo-b"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "dorfberg-monitoring",
      "repos": [
        "BluefinOrg/REPLACE-dorfberg-repo"
      ],
      "env": {},
      "mcp": []
    },
    {
      "slug": "ops-plain",
      "repos": [
        "REPLACE-you/REPLACE-ops-ledger"
      ],
      "driver": "ssh-docker",
      "sandbox": {
        "privileged": false,
        "dind": false,
        "mounts": [
          "/srv/ops/sources:/data/sources"
        ]
      },
      "scrubSecrets": true,
      "systemPrompt": "Example of a docker-less project on the `plain` image variant (snapshot/plain/Dockerfile): an ordinary unprivileged container with a read-only data mount. See docs/sandbox-drivers.md.",
      "env": {},
      "mcp": []
    }
  ]
}
