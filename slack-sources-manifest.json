{
    "display_information": {
        "name": "CoachAven Sources",
        "description": "Reads the conversations you are in for CoachAven's sources store (a user token, no bot).",
        "background_color": "#001b6b"
    },
    "oauth_config": {
        "scopes": {
            "user": [
                "channels:read",
                "groups:read",
                "im:read",
