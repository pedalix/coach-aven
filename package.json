{
  "name": "coach-aven",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedalix/coach-aven.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "CoachAven — open-source agent infrastructure for operators who run many client systems: per-project Claude Code sandboxes, driven from Slack, Teams or the web.",
  "homepage": "https://coachaven.com",
  "bin": {
    "orch": "./src/cli.ts"
  },
  "scripts": {
    "orch": "tsx src/cli.ts",
    "lab": "tsx src/lab/cli.ts",
    "cli-probe": "tsx src/cliprobe/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "ops": "infra/deploy/deploy.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@microsoft/teams.api": "2.1.0",
    "@microsoft/teams.apps": "2.1.0",
    "@octokit/auth-app": "^7.1.5",
    "@sentry/node": "^10.62.0",
    "@slack/bolt": "^4.7.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "markdown-it": "14.3.3",
    "openid-client": "6.8.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
