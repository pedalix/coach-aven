{
  "name": "coach-aven",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "CoachAven — a Slack coding agent running per-project Claude Code sandboxes on self-hosted Daytona.",
  "bin": {
    "orch": "./src/cli.ts"
  },
  "scripts": {
    "orch": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "prod:install": "infra/prod/deploy.sh install",
    "prod:export": "infra/prod/deploy.sh export",
    "prod:import": "infra/prod/deploy.sh import",
    "prod:push-secrets": "infra/prod/deploy.sh export",
    "prod:deploy": "infra/prod/deploy.sh deploy",
    "prod:logs": "infra/prod/deploy.sh logs",
    "prod:status": "infra/prod/deploy.sh status",
    "prod:restart": "infra/prod/deploy.sh restart",
    "prod:start": "infra/prod/deploy.sh start",
    "prod:stop": "infra/prod/deploy.sh stop",
    "prod:ssh": "infra/prod/deploy.sh ssh",
    "prod:down": "infra/prod/deploy.sh down"
  },
  "dependencies": {
    "@daytonaio/sdk": "0.187.0",
    "@octokit/auth-app": "^7.1.5",
    "@slack/bolt": "^4.7.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
