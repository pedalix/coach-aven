# ── Sandbox driver ───────────────────────────────────────────────────────────
# Deployment-wide default provider: 'daytona' or 'ssh-docker' (see docs/sandbox-drivers.md).
# Overridable per project via the `driver` field in projects.config.json. Only the
# provider(s) actually selected need their config block below.
SANDBOX_DRIVER=daytona

# ── Daytona (self-hosted; OSS frozen 06/2026 — pin versions) ─────────────────
DAYTONA_API_URL=https://<daytona-host>/api
DAYTONA_API_KEY=dtn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DAYTONA_ORGANIZATION_ID=8fa6734c-74f2-49c0-9504-92b09cf7f259

# ── ssh-docker (sandboxes = containers on a host we own, over SSH) ───────────
# Only needed when SANDBOX_DRIVER=ssh-docker or a project sets "driver": "ssh-docker".
# Host prereqs: docker + key-based SSH for this user (BatchMode; use an ~/.ssh/config
# alias for port/key options). Runtime: 'sysbox-runc' (preferred, needs sysbox installed)
# or 'privileged' (works everywhere; containers are root-equivalent on the host).
#SSHDOCKER_HOST=aven@sandboxes.example.com
#SSHDOCKER_RUNTIME=privileged

# ── Snapshot (the project sandbox image) ─────────────────────────────────────
# Pin SNAPSHOT_IMAGE to the :<gitsha> tag build-and-push.sh prints (not :latest — the
# fleet should run a known image). Only consulted when creating a NEW snapshot name;
# an already-active snapshot is left as-is.
SNAPSHOT_NAME=bluefin-sandbox-laravel
SNAPSHOT_IMAGE=ghcr.io/bluefinorg/bluefin-sandbox-laravel:<gitsha>
# DinD wants >=2 vCPU / 4 GiB; disk holds the repo + nested docker images.
SANDBOX_CPU=2
SANDBOX_MEMORY=4
SANDBOX_DISK=20
# Idle minutes before Daytona auto-stops a warm sandbox (orchestrator restarts on demand).
SANDBOX_AUTOSTOP_MINUTES=30

# ── Claude Code (subscription) ───────────────────────────────────────────────
# Generate once on a machine logged in to Claude Max:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub auth (in-box clone / push / PR) ───────────────────────────────────
# Scoping: the App is installed org-wide (many repos), but the orchestrator mints a
# per-task installation token SCOPED to ONLY the project's repo(s) (repositoryNames)
# + minimal permissions (contents+pull_requests write, metadata read). So each
# sandbox can touch only its own project's repos — see getGitHubToken() in github.ts.
#
# Option A — plain token (simplest): a PAT or `gh auth token`. Wins if set.
# NOTE: a plain token is NOT repo-scoped — use the App (Option B) for least privilege.
GITHUB_TOKEN=
#
# Option B — GitHub App (recommended for orgs). App ID + PEM only; the installation
# id is auto-discovered from the repo owner (set GITHUB_APP_INSTALLATION_ID to skip).
GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# Provide the PEM inline (\n-escaped) OR point to a file path. The file path wins.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# Base dir inside the sandbox where project repos + worktrees live.
SANDBOX_WORK_DIR=/root/work

# ── dev vs prod on a SHARED Daytona ───────────────────────────────────────────
# Prefix for sandbox names (default `proj-` → `proj-<slug>`). Local dev and prod
# point at the same Daytona, so set a DISTINCT prefix in your local .env (e.g.
# `dev-proj-`) — otherwise dev and prod with the same slug land in the SAME warm
# sandbox and trample each other's worktrees. Leave default on the prod box.
# SANDBOX_NAME_PREFIX=dev-proj-

# ── Slack bot (Socket Mode) — only needed for `orch slack` ────────────────────
# ONE bot, MANY channels: each channel is bound to a project (channel = context =
# the project's own sandbox). Scopes per slack-app-manifest.json (app_mentions:read,
# chat:write, commands, *:history, reactions:write, im:write, …).
#
# DEV vs PROD: use a SEPARATE Slack app for local dev. Socket Mode delivers each
# event to only ONE connected socket, so a dev bot sharing prod's app would steal
# ~half of prod's events. Create a second app (slack-app-manifest.json) and put its
# own xoxb-/xapp- tokens here, then set SLACK_CHANNEL_PREFIX + SLACK_COMMAND below.
# Bot User OAuth Token (xoxb-…).
SLACK_BOT_TOKEN=
# App-Level Token (xapp-…) with connections:write (enables Socket Mode).
SLACK_APP_TOKEN=
# Channel-name prefix the bot auto-binds to a project slug (default `bluefin-aven-` →
# `bluefin-aven-<slug>`). In the same workspace, give dev its own prefix (e.g.
# `dev-bluefin-aven-`) so the dev app only answers in dev channels.
# SLACK_CHANNEL_PREFIX=dev-bluefin-aven-
# Slash command the bot answers to (default `/aven`). Slack forbids two apps in one
# workspace from owning the same command, so the dev app must use a different one —
# set this to match the dev app's manifest (e.g. `/dev-aven`).
# SLACK_COMMAND=/dev-aven

# ── Slack multi-workspace OAuth (optional; Public Distribution) ───────────────
# Set ALL THREE to switch the bot to OAuth multi-workspace mode: clients install via
# https://<host>:<SLACK_OAUTH_PORT>/slack/install and per-workspace bot tokens are
# persisted in state.json (`installations`, hence its 0600 mode). SLACK_BOT_TOKEN then
# becomes optional — when present it seeds OUR workspace's installation on first boot.
# Events still ride Socket Mode for every workspace; the HTTP listener exists only for
# the install handshake (put it behind your reverse proxy / HTTPS).
# Basic Information → App Credentials:
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Any long random string (signs the OAuth `state` cookie):
# SLACK_STATE_SECRET=
# HTTP port for /slack/install + /slack/oauth_redirect (default 3000):
# SLACK_OAUTH_PORT=3000
# Bot scopes requested at install (default: the manifest's bot scope list in config.ts):
# SLACK_SCOPES=
# OUR workspace's team id (T…) — pollers/alerts/recovery run there. Optional when
# SLACK_BOT_TOKEN is set (auto-resolved via auth.test):
# SLACK_HOME_TEAM_ID=
# Tenant gate is registry-driven since slice 2: a workspace is served iff the
# `workspaces` block in projects.config.json grants it projects (home always is).
# SLACK_ALLOWED_TEAMS remains honored as a TRANSITIONAL extra allowlist (comma-separated
# team ids) — prefer the workspaces block.
# SLACK_ALLOWED_TEAMS=T012ABC3DEF,T045GHI6JKL
# Shown to installed-but-unconfigured workspaces ("contact … to get set up") in the App
# Home onboarding view and the one-time polite reply:
# AVEN_CONTACT=owen@example.com
# Channel→project registry. Copy projects.config.example.json → projects.config.json
# (gitignored); bind each bluefin-{project} channel id to its slug + repos.
PROJECTS_CONFIG_PATH=./projects.config.json

# Human-only NOTE prefix: a message starting with this is NOT sent to the agent — jot
# something for yourself/a colleague mid-thread without triggering Claude. The bot just
# adds NOTE_REACTION to confirm it skipped. Default prefix `!` (a leading `/` collides
# with Slack's slash-command UI); default reaction 🤫.
# SLACK_NOTE_PREFIX=!
# SLACK_NOTE_REACTION=shushing_face

# ── Per-project MCP secrets ───────────────────────────────────────────────────
# A project's mcp[] env values can reference ${ENV_NAME}; the orchestrator resolves
# them from here (so secrets live in .env, not in projects.config.json). caldora's
# `grafana` MCP server needs a Grafana service-account token (Viewer is enough):
# Grafana → Administration → Users and access → Service accounts → add token.
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ── Observability: Sentry (optional) ─────────────────────────────────────────
# Set SENTRY_DSN to send errors + performance traces to Sentry (off if unset, so dev/CI
# run clean). PII is disabled and secrets are scrubbed from outbound events. Structured
# logs are OPT-IN (SENTRY_LOGS=1) because they send log content to Sentry's cloud.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production        # defaults to NODE_ENV or "production"
# SENTRY_RELEASE=v0.8.0                # tie issues to a version (set per release if you want)
# SENTRY_TRACES_SAMPLE_RATE=1          # 0–1; 1 = trace every turn (fine at this volume)
# SENTRY_LOGS=0                        # 1 = also stream structured logs to Sentry

# ── Operator error alerts to Slack (optional) ────────────────────────────────
# Channel ID (e.g. C0123ABCD) the bot posts its own errors to — free-tier Slack alerting
# that Sentry's free plan can't do. The bot must be invited to that channel.
# AVEN_ALERT_CHANNEL=

# ── YouTrack support-ticket investigation (optional pilot) ────────────────────
# When set, the bot polls YouTrack for tickets tagged with YOUTRACK_LABEL, routes each to
# the project owning its id prefix (projects.config.json → youtrackProjects: ["GLACIER", …])
# and opens a read-only investigation in that project's bluefin-aven-<slug> channel. Off unless
# both URL and TOKEN are set. Token = a read-only YouTrack permanent token (Profile → Account
# Security → New token, scope: YouTrack).
# YOUTRACK_URL=https://yourorg.youtrack.cloud
# YOUTRACK_TOKEN=perm:xxxxxxxx
# YOUTRACK_LABEL=AI auto review          # the trigger tag (default: "AI auto review")
# YOUTRACK_PING=U0123ABCD,U0456EFGH      # Slack user ids to @-mention with each finding
