#!/bin/sh
# CoachAven quickstart (docs/quickstart.md; OpenSpec quickstart D4, D9). Run it from anywhere:
#
#   ./coach-aven init [owner/repo]   set up this directory; with a repository, write it into projects.config.json
#   ./coach-aven setup-token         get a Claude subscription token without installing Claude Code
#   ./coach-aven up                  start (or restart, after an edit) the bot, then print the sign-in link
#   ./coach-aven link                print the sign-in link of the running bot
#   ./coach-aven logs                follow the bot's log
#   ./coach-aven down                stop the bot (the sandbox stays, with your tokens: see uninstall)
#   ./coach-aven uninstall           stop the bot, remove its sandboxes and the two images of this version
#
# `init` writes what it can learn from this machine and nothing you have to obtain:
#   - .env and projects.config.json from their examples, only when they are missing (yours are never touched,
#     except the `repos` line when you name a repository);
#   - compose/.env, rewritten every time: the bot image of this clone's commit (its tag, else sha-<commit>),
#     your uid and gid, the Docker socket's group as a container sees it, the web port (AVEN_WEB_PORT, 8787), and
#     SANDBOX_IMAGE when you set it (another sandbox image than the published one of the same version);
#   - the bot image and the sandbox image pulled, so the first answer does not wait for a download;
#   - home/, the bot's HOME.
# Nothing here reads, writes or prints a token.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
cd "$here"

compose() { docker compose -f "$here/compose/compose.yaml" --project-directory "$here/compose" "$@"; }
need_init() { [ -f compose/.env ] || { echo "error: run ./coach-aven init first" >&2; exit 1; }; }

# The sign-in line of the bot's current start: the log keeps every earlier start's line, and only the newest key
# signs in, so read the log from the moment the running container started.
signin() {
  id=$(compose ps -q bot 2>/dev/null) || true
  [ -n "$id" ] || return 1
  since=$(docker inspect -f '{{.State.StartedAt}}' "$id") || return 1
  compose logs --no-log-prefix --since "$since" bot 2>/dev/null | grep 'sign-in' | tail -n 1 | sed 's/.*sign-in: //'
}

init() {
  for f in .env projects.config.json; do
    case $f in .env) src=.env.example ;; *) src=projects.config.example.json ;; esac
    if [ -e "$f" ]; then
      echo "kept     $f"
    else
      cp "$src" "$f"
      chmod 600 "$f"
      echo "created  $f (from $src)"
    fi
  done
  if [ -n "${1:-}" ]; then
    echo "$1" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || { echo "error: '$1' is not owner/repo" >&2; exit 1; }
    grep -Eq '"repos": \[[^]]*\]' projects.config.json || { echo "error: no one-line \"repos\" in projects.config.json — edit it by hand" >&2; exit 1; }
    sed -E "s#\"repos\": \[[^]]*\]#\"repos\": [\"$1\"]#" projects.config.json > projects.config.json.tmp
    mv projects.config.json.tmp projects.config.json
    echo "wrote    $1 into projects.config.json"
  fi
  mkdir -p home

  # The image of this very commit, so the bot and the sandbox's Dockerfile come from the same point.
  if tag=$(git describe --tags --exact-match 2>/dev/null); then
    version=$tag
  else
    head=$(git rev-parse HEAD 2>/dev/null) || { echo "error: $here is not in a git clone of CoachAven — clone it (docs/quickstart.md, step 1)" >&2; exit 1; }
    version=sha-$head
    echo "warning: this clone is not at a release tag; using $version, the image of a main commit (a canary build)." >&2
    echo "         For a release: git checkout \$(git describe --tags --abbrev=0) and rerun ./coach-aven init" >&2
  fi
  image=ghcr.io/pedalix/coach-aven:$version

  docker version >/dev/null 2>&1 || { echo "error: Docker does not answer — start Docker (Docker Desktop, or the docker service) and rerun" >&2; exit 1; }
  unpublished() {
    echo "error: $1 is not published — only release tags and main's commits have images." >&2
    echo "       Check out a release (git checkout \$(git describe --tags --abbrev=0)) or main, and rerun." >&2
    exit 1
  }
  # Both images now, so the first answer does not wait for a download.
  echo "pulling  $image"
  docker pull -q "$image" >/dev/null 2>&1 || unpublished "$image"
  sandbox=${SANDBOX_IMAGE:-ghcr.io/pedalix/coach-aven-sandbox-plain:$version}
  echo "pulling  $sandbox (the sandbox)"
  case $sandbox in
    ghcr.io/*) docker pull -q "$sandbox" >/dev/null 2>&1 || unpublished "$sandbox" ;;
    *) docker image inspect "$sandbox" >/dev/null 2>&1 || { echo "error: no local image $sandbox — build it first" >&2; exit 1; } ;;
  esac

  # The socket's group as a container sees it: on Docker Desktop the host's own `stat` reads a symlink, not that.
  docker_gid=$(docker run --rm --entrypoint stat -v /var/run/docker.sock:/var/run/docker.sock "$image" -c %g /var/run/docker.sock)
  # The bot will run as you with that group: check now that it reaches Docker, rather than in the bot's log later.
  docker run --rm --user "$(id -u):$(id -g)" --group-add "$docker_gid" -v /var/run/docker.sock:/var/run/docker.sock \
    --entrypoint docker "$image" version >/dev/null 2>&1 || {
    echo "error: a container running as uid $(id -u) with group $docker_gid cannot reach /var/run/docker.sock." >&2
    echo "       Rootless Docker, Podman and Colima are untested (docs/quickstart.md); report what you run." >&2
    exit 1
  }

  port=${AVEN_WEB_PORT:-8787}
  cat > compose/.env <<ENV
# Written by ../coach-aven init from this machine — rerun it rather than editing.
AVEN_VERSION=$version
AVEN_UID=$(id -u)
AVEN_GID=$(id -g)
DOCKER_GID=$docker_gid
AVEN_WEB_PORT=$port
${SANDBOX_IMAGE:+SANDBOX_IMAGE=$SANDBOX_IMAGE}
ENV
  echo "wrote    compose/.env ($version, uid $(id -u), docker group $docker_gid, port $port)"

  echo
  echo "Next:"
  echo "  1. Fill CLAUDE_CODE_OAUTH_TOKEN and GITHUB_TOKEN in $here/.env (./coach-aven setup-token gets the first)"
  [ -n "${1:-}" ] || echo "     and your repository in $here/projects.config.json (or rerun: ./coach-aven init owner/repo)."
  echo "  2. ./coach-aven up"
}

up() {
  need_init
  # Always a fresh start: the bot reads .env and projects.config.json only when it starts.
  compose up -d --force-recreate
  echo "waiting for the sign-in link …"
  i=0
  while [ $i -lt 30 ]; do
    url=$(signin) || url=
    if [ -n "$url" ]; then echo "Open: $url"; return 0; fi
    sleep 1
    i=$((i + 1))
  done
  echo "error: no sign-in link after 30 s — ./coach-aven logs shows why" >&2
  exit 1
}

uninstall() {
  need_init
  version=$(sed -n 's/^AVEN_VERSION=//p' compose/.env)
  sandbox=$(sed -n 's/^SANDBOX_IMAGE=//p' compose/.env)
  label=$(sed -n 's/^SANDBOX_MANAGED_BY=//p' .env 2>/dev/null)
  compose down
  # The sandboxes are not compose services, and they hold your tokens.
  ids=$(docker ps -aq --filter "label=managedBy=${label:-coach-aven-quickstart}")
  [ -z "$ids" ] || docker rm -f $ids >/dev/null
  # Only this version's two images; an image another container still uses stays.
  docker image rm "ghcr.io/pedalix/coach-aven:$version" "${sandbox:-ghcr.io/pedalix/coach-aven-sandbox-plain:$version}" 2>/dev/null || true
  echo "Removed. Your settings, the state and the chat's history stay in $here: git clean -fdX \"$here\" deletes them."
}

case ${1:-} in
  init) shift; init "${1:-}" ;;
  setup-token) need_init; compose run --rm setup-token ;;
  up) up ;;
  link) need_init; url=$(signin) || url=; [ -n "$url" ] && echo "$url" || { echo "error: the bot is not running — ./coach-aven up" >&2; exit 1; } ;;
  logs) need_init; compose logs -f bot ;;
  down) need_init; compose down ;;
  uninstall) uninstall ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; [ -z "${1:-}" ] || exit 1 ;;
esac
