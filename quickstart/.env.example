# CoachAven quickstart — the bot's settings (docs/quickstart.md). ./init.sh copies this file to .env once;
# fill the three values marked FILL, then `docker compose up -d` in compose/. Everything else is the trial's
# safe shape: the web chat on this machine only, unprivileged sandboxes on this machine's Docker.

# ── The model credit: EXACTLY ONE of the two ──────────────────────────────────
# FILL — to try it: a Claude subscription token. `claude setup-token` on any machine with Claude Code, or,
# without installing anything, from compose/: docker compose run --rm sandbox-image claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# For a team or clients, an Anthropic API key instead (comment the token out). The sandbox can read it: use a
# dedicated key in its own Anthropic workspace with a monthly spend limit.
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# The Claude Code CLI the sandboxes run; a sandbox converges to it when a conversation starts.
CLAUDE_CLI_VERSION=2.1.292

# ── GitHub ─────────────────────────────────────────────────────────────────────
# FILL — a fine-grained token (github.com/settings/personal-access-tokens): ONE repository, the one in
# projects.config.json; permissions Contents: read and write, Pull requests: read and write; an expiry.
# The sandbox can read it.
GITHUB_TOKEN=

# ── Sandboxes: containers on this machine's Docker, unprivileged ───────────────
SANDBOX_DRIVER=ssh-docker
SSHDOCKER_HOST=local
# Built by compose from snapshot/plain at the first `up`; never pulled.
SNAPSHOT_IMAGE=coach-aven-sandbox-plain:local
# Names of the quickstart's own: it never shares a container with another installation on this machine.
SANDBOX_NAME_PREFIX=qs-
SANDBOX_MANAGED_BY=coach-aven-quickstart
SANDBOX_AUTOSTOP_MINUTES=30

# ── The web chat ───────────────────────────────────────────────────────────────
# A sign-in link with a new key at every start, in the bot's log (docker compose logs bot | grep sign-in | tail -n 1).
# compose publishes the port on 127.0.0.1 only; WEB_PORT and WEB_BASE_URL come from compose/.env (init.sh).
WEB_AUTH=link
WEB_BIND=0.0.0.0
