# CoachAven quickstart — the bot's settings (docs/quickstart.md). `./coach-aven up` copies this file to .env once and
# asks for the values marked FILL (or fill them here). Everything else is the trial's safe shape: the web chat on this
# machine only, unprivileged sandboxes on this machine's Docker.

# ── The model credit: EXACTLY ONE of the two ──────────────────────────────────
# FILL — to try it: a Claude subscription token. `claude setup-token` on any machine with Claude Code, or,
# without installing anything: ./coach-aven setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# For a team or clients, an Anthropic API key instead (comment the token out). The sandbox can read it: use a
# dedicated key in its own Anthropic workspace with a monthly spend limit.
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# The Claude Code CLI the sandboxes run; a sandbox converges to it when a conversation starts.
CLAUDE_CLI_VERSION=2.1.314

# ── GitHub ─────────────────────────────────────────────────────────────────────
# FILL, or not — a fine-grained token (github.com/settings/personal-access-tokens): ONE repository, the one in
# projects.config.json; permissions Contents: read and write, Pull requests: read and write; an expiry. The sandbox
# can read it. Without one, GITHUB_AUTH=none: the agent reads a public repository and opens no pull requests.
GITHUB_TOKEN=
# GITHUB_AUTH=none

# ── Sandboxes: containers on this machine's Docker, unprivileged ───────────────
SANDBOX_DRIVER=ssh-docker
SANDBOX_HOST=local
# The sandbox image is set by compose: the published plain image of the bot's version (compose/compose.yaml).
# Names of the quickstart's own: it never shares a container with another installation on this machine.
SANDBOX_NAME_PREFIX=qs-
SANDBOX_MANAGED_BY=coach-aven-quickstart
SANDBOX_AUTOSTOP_MINUTES=30

# ── The web chat ───────────────────────────────────────────────────────────────
# A sign-in link with a new key at every start: ./coach-aven up prints it, ./coach-aven link prints it again.
# compose publishes the port on 127.0.0.1 only; WEB_PORT and WEB_BASE_URL come from compose/.env (init.sh).
WEB_AUTH=link
WEB_BIND=0.0.0.0

# ── Slack beside the web chat (optional) ──────────────────────────────────────
# A Slack app made from ../slack-app-manifest.json (Socket Mode on): uncomment the three lines with its two tokens,
# then `./coach-aven up`. A channel named aven-demo drives the project `demo`: invite the bot, @mention it there.
# CHAT_SURFACES=slack
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
